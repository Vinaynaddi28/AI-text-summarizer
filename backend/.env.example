# Copy this file to .env and add your own key locally.
GEMINI_API_KEY=your_google_ai_studio_api_key_here
# Set a model available to your Gemini API project. Availability and free-tier
# limits can change; gemini-3-flash-preview is the default used by this project.
GEMINI_MODEL=gemini-3-flash-preview
# PDF upload size in bytes; 5242880 = 5 MB.
PDF_MAX_UPLOAD_BYTES=5242880
OLLAMA_MODEL=llama3.2
# Optional: set this to your local Tesseract executable if not on PATH.
TESSERACT_CMD=
PDF_MAX_PAGES=30
PDF_MAX_OCR_PAGES=10
PDF_OCR_TIMEOUT_SECONDS=120
